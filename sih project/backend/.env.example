# Backend Environment Variables Template for Render / Docker / Local
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./health_risk.db
BACKEND_CORS_ORIGINS=*

# Optional Email Dispatch (Gmail SMTP / Custom)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=alerts@medisentinel.gov.in

# Optional SMS Dispatch (Fast2SMS / Twilio)
# SMS_API_KEY=your_fast2sms_api_key
# SMS_SENDER_ID=IDSPOD
