# Frontend Environment Variables Template for Vercel / Local
# Local Development (leave empty to use Vite proxy to http://127.0.0.1:8000)
# VITE_API_URL=

# Live Production Deployment on Vercel:
# Set this to your live Render backend URL:
# VITE_API_URL=https://your-medisentinel-backend.onrender.com

# CARTO Basemaps API Key (Get a 100% free key with no watermark at https://carto.com/basemaps/apikey)
# VITE_CARTO_API_KEY=your_free_carto_api_key_here
